# Required for real ranking. Choose one provider with LLM_PROVIDER.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local runtime defaults
STORAGE_BACKEND=local
STATE_BACKEND=sqlite
LOCAL_ROOT=.
WHISPER_MODEL=base
WHISPER_DEVICE=auto
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
YTDLP_PLAYER_CLIENTS=
NOTIFY_WEBHOOK_URL=

# Cloud mode
GCS_BUCKET=
FIRESTORE_PROJECT=
